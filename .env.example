# Copia este archivo como .env y rellena los valores.
#   cp .env.example .env

# Host de la base de datos (nombre del servicio en docker-compose)
DB_HOST=db_eduino

# Nombre de la base de datos
DB_NAME=eduino_db

# Usuario y contraseña de la aplicación
DB_USER=
DB_PASS=

# Contraseña de root de MySQL
MYSQL_ROOT_PASSWORD=
